{
  "name": "Dashboard Entity Proxy",
  "slug": "dashboard_entity_proxy",
  "description": "Filters Home Assistant WebSocket entity subscriptions per dashboard so slow devices only process the updates they display.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.1.1",
  "image": "ghcr.io/bakerkj/{arch}-dashboard_entity_proxy",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "init": false,
  "ingress": true,
  "map": [
    "homeassistant_config:ro"
  ],
  "ingress_port": 8098,
  "panel_icon": "mdi:transit-connection-variant",
  "panel_title": "Entity Proxy",
  "ports": {
    "8126/tcp": 8126
  },
  "ports_description": {
    "8126/tcp": "Proxy HTTP/WebSocket endpoint for browser/tablet clients"
  },
  "options": {
    "homeassistant_url": "http://homeassistant:8123",
    "transparent": true,
    "dashboard_url_path": "",
    "state_update_interval": "",
    "extra_entities": [],
    "include_entity_globs": [],
    "exclude_entity_globs": [],
    "passthrough_all": false,
    "log_level": "INFO",
    "customization_file": "/homeassistant/dashboard_entity_proxy.yaml",
    "show_client_paths": true,
    "registry_mode": "incremental",
    "registry_refetch_interval": 60,
    "registry_burst_threshold": 50
  },
  "schema": {
    "homeassistant_url": "str",
    "transparent": "bool",
    "dashboard_url_path": "str?",
    "state_update_interval": "str?",
    "extra_entities": [
      "str"
    ],
    "include_entity_globs": [
      "str"
    ],
    "exclude_entity_globs": [
      "str"
    ],
    "passthrough_all": "bool?",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "customization_file": "str?",
    "show_client_paths": "bool?",
    "registry_mode": "list(full|incremental)?",
    "registry_refetch_interval": "float(0,)?",
    "registry_burst_threshold": "int(0,)?"
  }
}
