#!/command/with-contenv bash
# shellcheck shell=bash
#
# Render /etc/nginx/nginx.conf from /etc/nginx/nginx.conf.tmpl using
# values from /data/options.json. Run by the init-nginx-conf cont-init
# oneshot before nginx-longrun starts.
#
# Substitutions:
#   __HA_HOST__              — host portion of homeassistant_url
#   __HA_PORT__              — port portion (defaults to 8123 when absent)
#   __XFWD_BLOCK__           — proxy_set_header X-Forwarded-* lines, or
#                              empty when transparent: true (matching
#                              the Python proxy's transparent mode
#                              behaviour for HTTP)
#   __STDERR_ACCESS_LOG__    — ``access_log /dev/stderr combined;`` at
#                              log_level=DEBUG, ``access_log off;``
#                              otherwise. nginx is DEBUG-only because
#                              the Python apps already emit a richer
#                              access log via ``_RealIPAccessLogger`` at
#                              INFO (real upstream IP, post-ingress-strip
#                              URI).
#
# Reads options.json with jq directly rather than bashio::config: the
# Supervisor API roundtrip bashio tries first fails to fall back
# cleanly in some environments (tests, manual invocations), and the
# substitution doesn't need any of bashio's other features.
set -euo pipefail

readonly TMPL=/etc/nginx/nginx.conf.tmpl
readonly OUT=/etc/nginx/nginx.conf
readonly OPTS=/data/options.json

[[ -f "$TMPL" ]] || { echo "missing template: $TMPL" >&2; exit 1; }
[[ -f "$OPTS" ]] || { echo "missing options: $OPTS" >&2; exit 1; }

ha_url=$(jq -r '.homeassistant_url // "http://homeassistant:8123"' "$OPTS")
transparent=$(jq -r '.transparent // true' "$OPTS")
log_level=$(jq -r '.log_level // "INFO"' "$OPTS" | tr '[:lower:]' '[:upper:]')

# Validate scheme. Reject anything that isn't a plain http(s) URL before
# parsing — keeps malformed/injected values (newlines, ``};``, etc.) from
# leaking into the rendered nginx.conf via the sed substitution below.
if [[ "$ha_url" == http://* ]]; then
  host_port="${ha_url#http://}"
elif [[ "$ha_url" == https://* ]]; then
  host_port="${ha_url#https://}"
else
  echo "invalid homeassistant_url (scheme must be http:// or https://): ${ha_url}" >&2
  exit 1
fi
host_port="${host_port%%/*}"
if [[ "$host_port" == *":"* ]]; then
  ha_host="${host_port%%:*}"
  ha_port="${host_port##*:}"
else
  ha_host="$host_port"
  ha_port=8123
fi

# Whitelist host/port shape. nginx directives are terminated by ``;`` and
# ``{}``; refusing anything outside a conservative DNS/IP charset blocks
# config injection through a crafted homeassistant_url.
if [[ ! "$ha_host" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "invalid homeassistant_url host: ${ha_host}" >&2
  exit 1
fi
if [[ ! "$ha_port" =~ ^[0-9]+$ ]]; then
  echo "invalid homeassistant_url port: ${ha_port}" >&2
  exit 1
fi

# Transparent mode (HA treats nginx as a direct client): no
# X-Forwarded-*. Non-transparent: forward identity headers so HA's
# trusted_proxies config can attribute the request.
if [[ "$transparent" == "true" ]]; then
  xfwd_block=""
else
  xfwd_block=$(cat <<'EOF'
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
EOF
)
fi

# nginx's stderr access log is DEBUG-only; Python's apps emit the
# canonical INFO access log via ``_RealIPAccessLogger``.
if [[ "$log_level" == "DEBUG" ]]; then
  stderr_access_log='access_log /dev/stderr combined;'
else
  stderr_access_log='access_log off;'
fi

echo "nginx config: ha_backend=${ha_host}:${ha_port} transparent=${transparent} log_level=${log_level}"

# Two-step substitution: simple placeholders via sed first, then the
# multi-line block via Python (sed's newline gymnastics aren't worth it).
sed -e "s|__HA_HOST__|${ha_host}|g" \
    -e "s|__HA_PORT__|${ha_port}|g" \
    -e "s|__STDERR_ACCESS_LOG__|${stderr_access_log}|g" \
    "$TMPL" > "${OUT}.in"

XFWD_BLOCK="$xfwd_block" python3 -c '
import os, sys
src = open(sys.argv[1]).read()
sys.stdout.write(src.replace("__XFWD_BLOCK__", os.environ["XFWD_BLOCK"]))
' "${OUT}.in" > "$OUT"

rm -f "${OUT}.in"
