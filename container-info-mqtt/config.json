{
  "name": "Container Info MQTT",
  "slug": "container_info_mqtt",
  "description": "Publishes Docker container metrics and limits (cpuset, CPU shares, blkio weight) as Home Assistant MQTT Discovery sensors.",
  "url": "https://github.com/bakerkj/hass-apps/tree/main/container-info-mqtt",
  "version": "0.1.1",
  "arch": ["amd64", "aarch64"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "hassio_api": false,
  "homeassistant_api": false,
  "docker_api": true,
  "host_network": false,
  "ingress": false,
  "full_access": false,
  "options": {
    "interval_seconds": 30,
    "docker_timeout_seconds": 10,
    "include_metrics": "cpu_percent,memory_usage,network_rx_total,network_tx_total,io_read_total,io_write_total,network_rx_rate,network_tx_rate,io_read_rate,io_write_rate,status,cpuset_cpus,cpu_shares,blkio_weight",
    "container_include_regex": "",
    "container_exclude_regex": "",
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "container_info",
    "client_id": "container-info-mqtt",
    "log_level": "INFO",
    "heartbeat_interval_seconds": 30
  },
  "schema": {
    "interval_seconds": "int(1,300)",
    "docker_timeout_seconds": "int(1,120)",
    "include_metrics": "str",
    "container_include_regex": "str?",
    "container_exclude_regex": "str?",
    "mqtt_host": "str",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str",
    "mqtt_base_topic": "str",
    "client_id": "str",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "heartbeat_interval_seconds": "int(5,600)"
  }
}
