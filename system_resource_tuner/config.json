{
  "name": "System Resource Tuner",
  "slug": "system_resource_tuner",
  "description": "Applies system resource tuning for containers (cpuset, CPU shares priority, blkio weight) and keeps it reconciled.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.0.33",
  "image": "ghcr.io/bakerkj/{arch}-system_resource_tuner",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "init": false,
  "docker_api": true,
  "host_pid": true,
  "full_access": true,
  "privileged": [
    "SYS_ADMIN",
    "SYS_NICE"
  ],
  "apparmor": false,
  "options": {
    "interval_seconds": 60,
    "apply_on_start": true,
    "dry_run": false,
    "log_level": "INFO",
    "post_start_retry_seconds": [
      0,
      1,
      3,
      8
    ],
    "post_start_retry_max_seconds": 30,
    "targets": [],
    "process_targets": [],
    "host_process_targets": []
  },
  "schema": {
    "interval_seconds": "int(5,86400)",
    "apply_on_start": "bool",
    "dry_run": "bool",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "post_start_retry_seconds": [
      "int(0,3600)"
    ],
    "post_start_retry_max_seconds": "int(0,3600)",
    "targets": [
      {
        "container": "str",
        "cpuset_cpus": "str?",
        "cpu_shares": "int(2,262144)?",
        "blkio_weight": "int(10,1000)?"
      }
    ],
    "process_targets": [
      {
        "container": "str?",
        "process_match_regex": "str?",
        "nice": "int?",
        "cpuset_cpus": "str?"
      }
    ],
    "host_process_targets": [
      {
        "process_match_regex": "str?",
        "nice": "int?",
        "cpuset_cpus": "str?"
      }
    ]
  }
}
