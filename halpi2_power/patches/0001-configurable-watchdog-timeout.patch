+++ b/config/halpid.conf	2026-07-21 23:57:33.526887444 -0400
@@ -34,3 +34,19 @@
 # Set to empty string for dry-run mode (testing without actually shutting down)
 # Default: /sbin/poweroff
 poweroff: /sbin/poweroff
+
+# Hardware Watchdog
+# -----------------
+# Timeout in milliseconds before the controller hard power-cycles the system
+# if it stops seeing I2C traffic from this daemon (default: 10000).
+#
+# The controller firmware feeds the watchdog on ANY I2C operation, so the
+# daemon's regular 100 ms polling keeps it alive. The daemon disarms it on a
+# clean shutdown (SIGINT/SIGTERM).
+#
+# Set to 0 to disable the watchdog entirely -- it is then never armed, and no
+# unattended power-cycle can occur. Choose this where an unexpected reset is
+# worse than a hung system, or where maintenance windows may exceed the timeout.
+#
+# Note the value is a u16, so the maximum is 65535 ms (~65 seconds).
+watchdog-timeout-ms: 10000
