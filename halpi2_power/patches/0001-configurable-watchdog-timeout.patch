+    #[test]
+    fn test_validate_watchdog_timeout() {
+        // 0 is valid and means "disabled"
+        let config = Config {
+            watchdog_timeout_ms: 0,
+            ..Default::default()
+        };
+        assert!(config.validate().is_ok());
+
+        // Anything shorter than a second races the 100 ms poll loop
+        let config = Config {
+            watchdog_timeout_ms: 500,
+            ..Default::default()
+        };
+        assert!(config.validate().is_err());
+
+        let config = Config {
+            watchdog_timeout_ms: 1000,
+            ..Default::default()
+        };
+        assert!(config.validate().is_ok());
+    }
+
