#!/command/with-contenv bash
# shellcheck shell=bash
# halpid: power controller state machine, watchdog, and shutdown coordination.
# The config is rendered by the init-halpid-conf oneshot (a dependency), so this
# only starts the daemon.
set -euo pipefail

echo "[halpi2] Starting halpid"
# exec matters: halpid must be this service's direct process so s6 delivers
# SIGTERM to it on stop. Its signal handler disarms the hardware watchdog --
# without that, a stop would leave an armed watchdog behind.
exec /usr/bin/halpid --conf /etc/halpid/halpid.conf
