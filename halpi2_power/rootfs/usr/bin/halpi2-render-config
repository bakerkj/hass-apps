#!/command/with-contenv bash
# shellcheck shell=bash
#
# Render /etc/halpid/halpid.conf from the add-on options.
#
# halpid's Config struct is declared `deny_unknown_fields`, so an unrecognised
# key is a hard startup error rather than a warning. Emit only keys the pinned
# upstream (plus our watchdog patch) actually accepts.
set -euo pipefail

OPTIONS="/data/options.json"
CONF_DIR="/etc/halpid"
CONF="${CONF_DIR}/halpid.conf"

if [[ ! -f "${OPTIONS}" ]]; then
  echo "[halpi2] Missing ${OPTIONS} (add-on options)." >&2
  exit 1
fi

get() { python3 -c "import json,sys; print(json.load(open('${OPTIONS}')).get(sys.argv[1], sys.argv[2]))" "$1" "$2"; }

MODE="$(get mode coop)"
WATCHDOG_TIMEOUT_MS="$(get watchdog_timeout_ms 10000)"
POWER_OUTAGE_TIME_LIMIT="$(get power_outage_time_limit 5.0)"
POWER_OUTAGE_VOLTAGE_LIMIT="$(get power_outage_voltage_limit 9.0)"
SHUTDOWN_VIA="$(get shutdown_via supervisor)"

# The schema guarantees an integer, but a hand-corrupted options.json could yield
# a float or null ("None"): the former would slip past the < 1000 arithmetic
# guard below, the latter would abort under `set -u`. Reject non-integers up front.
if [[ ! "${WATCHDOG_TIMEOUT_MS}" =~ ^[0-9]+$ ]]; then
  echo "[halpi2] watchdog_timeout_ms must be a non-negative integer, got '${WATCHDOG_TIMEOUT_MS}'." >&2
  exit 1
fi

# The controller's operating mode is not something we can set directly -- it is
# a consequence of whether the hardware watchdog is armed. Arming it puts the
# controller in Co-op; leaving it disarmed leaves it in Solo. Deriving the
# watchdog from an explicit `mode` keeps that coupling from being a surprise.
case "${MODE}" in
  coop)
    if [[ "${WATCHDOG_TIMEOUT_MS}" == "0" ]]; then
      echo "[halpi2] mode=coop requires a non-zero watchdog_timeout_ms." >&2
      echo "[halpi2] The controller only enters Co-op while the watchdog is armed." >&2
      echo "[halpi2] Either set a timeout (e.g. 10000) or switch to mode=solo." >&2
      exit 1
    fi
    # halpid's config validate() rejects any non-zero timeout below 1000 ms and
    # exits 1 at startup. The add-on schema (int(0,65535)) can't express "0 or
    # >=1000", so catch 1-999 here with a clear message instead of an obscure
    # halpid startup failure.
    if [[ "${WATCHDOG_TIMEOUT_MS}" -lt 1000 ]]; then
      echo "[halpi2] watchdog_timeout_ms=${WATCHDOG_TIMEOUT_MS} is below halpid's 1000 ms minimum." >&2
      echo "[halpi2] Set watchdog_timeout_ms to at least 1000 (e.g. 10000)." >&2
      exit 1
    fi
    ;;
  solo)
    # Force the watchdog off: a non-zero timeout would pull the controller into
    # Co-op and contradict the requested mode.
    if [[ "${WATCHDOG_TIMEOUT_MS}" != "0" ]]; then
      echo "[halpi2] mode=solo: ignoring watchdog_timeout_ms=${WATCHDOG_TIMEOUT_MS} (forcing 0)."
    fi
    WATCHDOG_TIMEOUT_MS=0
    ;;
  *)
    echo "[halpi2] Unknown mode '${MODE}' (expected coop or solo)." >&2
    exit 1
    ;;
esac

# `poweroff` is a first-class halpid config option, so redirecting shutdown to
# the Supervisor needs no source patch. An empty string puts halpid in dry-run:
# it runs the full state machine and logs the shutdown decision without acting.
case "${SHUTDOWN_VIA}" in
  supervisor) POWEROFF="/usr/bin/halpi2-shutdown" ;;
  mqtt_only)  POWEROFF="" ;;
  dry_run)    POWEROFF="" ;;
  *)
    echo "[halpi2] Unknown shutdown_via '${SHUTDOWN_VIA}'." >&2
    exit 1
    ;;
esac

mkdir -p "${CONF_DIR}"
cat > "${CONF}" <<EOF
# Generated by the HALPI2 Power add-on from /data/options.json.
# Edits here are overwritten on every add-on start.
i2c-bus: 1
i2c-addr: 0x6D
socket: /run/halpid/halpid.sock
socket-group: root
blackout-time-limit: ${POWER_OUTAGE_TIME_LIMIT}
blackout-voltage-limit: ${POWER_OUTAGE_VOLTAGE_LIMIT}
poweroff: "${POWEROFF}"
watchdog-timeout-ms: ${WATCHDOG_TIMEOUT_MS}
EOF

mkdir -p /run/halpid

# Pre-create the power outage evidence directory at startup rather than during a
# power outage. During an actual power failure the script is racing supercapacitor
# depletion, so every avoidable step is removed from that path. This also makes
# the /share mapping verifiable without waiting for a real event.
if [[ -d /share ]]; then
  mkdir -p /share/halpi2_power 2>/dev/null || true
  echo "[halpi2] power outage evidence will be written to /share/halpi2_power/power-outage-events.log"
else
  echo "[halpi2] WARNING: /share not mapped; power outage evidence goes to the add-on-private /data." >&2
fi

if [[ "${MODE}" == "solo" ]]; then
  echo "[halpi2] mode=solo: watchdog disabled, controller stays in OperationalSolo."
  echo "[halpi2] Telemetry only -- a power outage will end in an abrupt power cut."
else
  echo "[halpi2] mode=coop: watchdog armed at ${WATCHDOG_TIMEOUT_MS} ms."
  echo "[halpi2] Graceful power outage shutdown is active."
  echo "[halpi2] A gap longer than the timeout with no I2C traffic hard power-cycles the system."
fi

if [[ "${SHUTDOWN_VIA}" != "supervisor" ]]; then
  echo "[halpi2] shutdown_via=${SHUTDOWN_VIA}: halpid will NOT power the host off."
fi
