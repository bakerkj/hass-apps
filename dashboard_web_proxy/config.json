{
  "name": "Dashboard Web Proxy",
  "slug": "dashboard_web_proxy",
  "description": "Reverse-proxies LAN device web UIs so they can be embedded in Home Assistant dashboards -- strips X-Frame-Options and rewrites the session-cookie domain. One device per port.",
  "url": "https://github.com/bakerkj/hass-apps",
  "image": "ghcr.io/bakerkj/{arch}-dashboard_web_proxy",
  "version": "0.0.2",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "stage": "experimental",
  "startup": "services",
  "init": false,
  "ports": {
    "18800/tcp": 18800,
    "18801/tcp": 18801,
    "18802/tcp": 18802,
    "18803/tcp": 18803,
    "18804/tcp": 18804,
