{
  "name": "FFmpeg Snapshotter",
  "slug": "ffmpeg_snapshotter",
  "description": "Runs ffmpeg on-demand (per snapshot) to create timestamped JPEG snapshots from RTSP streams and maintains latest.jpg symlinks.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.8.9",
  "arch": ["amd64"],
  "startup": "services",
  "init": false,
  "video": true,
  "devices": ["/dev/dri"],
  "map": ["media:rw"],
  "options": {
    "log_level": "INFO",
    "ffmpeg": {
      "global_input_args": "-hide_banner -loglevel info -rtsp_transport tcp -timeout 5000000 -fflags +genpts+discardcorrupt -skip_frame nokey",
      "global_hwaccel_args": "-hwaccel vaapi -hwaccel_device /dev/dri/renderD128 -hwaccel_output_format vaapi",
      "global_output_args": "-q:v 3"
    },
    "housekeeping": {
      "retention_interval_seconds": 60
    },
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "ffmpeg_snapshotter",
    "mqtt_client_id": "ffmpeg-snapshotter",
    "mqtt_publish_interval_seconds": 60,
    "mqtt_disconnect_timeout_seconds": 300,
    "mqtt_rate_window_seconds": 300,
    "mqtt_snapshot_error_timeout_seconds": 300,
    "streams": []
  },
  "schema": {
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "ffmpeg": {
      "global_input_args": "str?",
      "global_hwaccel_args": "str?",
      "global_output_args": "str?"
    },
    "housekeeping": {
      "retention_interval_seconds": "int(5,3600)?"
    },
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str?",
    "mqtt_base_topic": "str?",
    "mqtt_client_id": "str?",
    "mqtt_publish_interval_seconds": "int(5,3600)?",
    "mqtt_disconnect_timeout_seconds": "int(5,3600)?",
    "mqtt_rate_window_seconds": "int(60,86400)?",
    "mqtt_snapshot_error_timeout_seconds": "int(10,86400)?",
    "streams": [
      {
        "name": "str",
        "url": "str",
        "interval_seconds": "int(1,3600)",
        "output_dir": "str",
        "filename_format": "str?",
        "date_dir_format": "str?",
        "latest_name": "str?",
        "retain_count": "int(0,100000)?",
        "retain_days": "int(0,3650)?",
        "extra_input_args": "str?",
        "extra_output_args": "str?"
      }
    ]
  }
}
