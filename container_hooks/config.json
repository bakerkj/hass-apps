{
  "name": "Container Hooks",
  "slug": "container_hooks",
  "description": "Per-container docker hooks: stage files, apply unified-diff patches, or run scripts at container create or start events — without forking the target image.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.1.5",
  "image": "ghcr.io/bakerkj/{arch}-container_hooks",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "system",
  "init": false,
  "docker_api": true,
  "hassio_role": "manager",
  "map": [
    "homeassistant_config:rw"
  ],
  "options": {
    "log_level": "INFO",
    "base_dir": "/homeassistant/container_hooks",
    "initial_sweep": true,
    "debounce_seconds": 2,
    "skip_containers": [],
    "container_overrides": [],
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "container_hooks",
    "client_id": "container-hooks",
    "health_interval_seconds": 30,
    "mqtt_disconnect_timeout_seconds": 300
  },
  "schema": {
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "base_dir": "str",
    "initial_sweep": "bool",
    "debounce_seconds": "int(0,60)",
    "skip_containers": [
      "str"
    ],
    "container_overrides": [
      {
        "container": "str",
        "debounce_seconds": "int(0,60)?",
        "success_sentinel": "str?",
        "success_sentinel_mode": "list(presence|content)?"
      }
    ],
    "mqtt_host": "str?",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str",
    "mqtt_base_topic": "str",
    "client_id": "str",
    "health_interval_seconds": "int(5,600)",
    "mqtt_disconnect_timeout_seconds": "int(5,600)"
  }
}
