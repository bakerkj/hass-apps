{
  "name": "Direwolf APRS IGate",
  "slug": "direwolf_igate",
  "description": "Receive-only APRS IGate using Direwolf with an RTL-SDR dongle.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.0.5",
  "image": "ghcr.io/bakerkj/{arch}-direwolf_igate",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "stage": "experimental",
  "init": false,
  "startup": "services",
  "usb": true,
  "services": [
    "mqtt:want"
  ],
  "options": {
    "mycall": "N0CALL-10",
    "iglogin_passcode": "",
    "igserver": "noam.aprs2.net",
    "frequency": "144.390M",
    "rtl_device": "0",
    "rtl_gain": "",
    "rtl_ppm": 0,
    "latitude": 0,
    "longitude": 0,
    "beacon_comment": "iGate | DireWolf",
    "beacon_symbol": "igate",
    "beacon_overlay": "R",
    "beacon_delay": "0:30",
    "beacon_every": "15:00",
    "send_status_beacon": true,
    "mqtt_enabled": false,
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "direwolf_igate",
    "client_id": "direwolf-igate",
    "interval_seconds": 30,
    "expire_after_multiplier": 4,
    "mqtt_disconnect_timeout_seconds": 300,
    "log_level": "INFO"
  },
  "schema": {
    "mycall": "str",
    "iglogin_passcode": "password",
    "igserver": "str",
    "frequency": "str",
    "rtl_device": "str",
    "rtl_gain": "str?",
    "rtl_ppm": "int(-1000,1000)",
    "latitude": "float(-90.0,90.0)",
    "longitude": "float(-180.0,180.0)",
    "beacon_comment": "str?",
    "beacon_symbol": "str",
    "beacon_overlay": "str",
    "beacon_delay": "str",
    "beacon_every": "str",
    "send_status_beacon": "bool",
    "mqtt_enabled": "bool",
    "mqtt_host": "str?",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str",
    "mqtt_base_topic": "str",
    "client_id": "str",
    "interval_seconds": "int(5,300)",
    "expire_after_multiplier": "int(2,10)",
    "mqtt_disconnect_timeout_seconds": "int(5,600)",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)"
  }
}
