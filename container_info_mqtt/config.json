{
  "name": "Container Info MQTT",
  "slug": "container_info_mqtt",
  "description": "Publishes Docker container metrics and limits (cpuset, CPU shares, blkio weight) as Home Assistant MQTT Discovery sensors.",
  "url": "https://github.com/bakerkj/hass-apps",
  "version": "0.1.16",
  "arch": ["amd64", "aarch64"],
  "startup": "services",
  "init": false,
  "docker_api": true,
  "options": {
    "interval_seconds": 30,
    "docker_timeout_seconds": 10,
    "include_metrics": "cpu_percent,memory_usage,network_rx_rate,network_tx_rate,io_read_rate,io_write_rate,uptime_seconds",
    "summary_metrics": "cpu_percent,memory_usage,network_rx_rate,network_tx_rate,io_read_rate,io_write_rate,uptime_seconds,cpu_shares,cpuset_cpus,blkio_weight",
    "container_include_regex": "",
    "container_exclude_regex": "^builder_",
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "container-info-write",
    "mqtt_password": "changeme",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "container_info",
    "client_id": "container-info-mqtt",
    "log_level": "INFO",
    "expire_after_multiplier": 4,
    "mqtt_disconnect_timeout_seconds": 300
  },
  "schema": {
    "interval_seconds": "int(1,300)",
    "docker_timeout_seconds": "int(1,120)",
    "include_metrics": "str",
    "summary_metrics": "str?",
    "container_include_regex": "str?",
    "container_exclude_regex": "str?",
    "mqtt_host": "str",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str",
    "mqtt_base_topic": "str",
    "client_id": "str",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "expire_after_multiplier": "int(2,10)",
    "mqtt_disconnect_timeout_seconds": "int(5,600)"
  }
}
