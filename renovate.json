{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6pm on friday"],
  "timezone": "America/New_York",
  "assignees": ["bakerkj"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Home Assistant add-on base images anywhere they're pinned: Dockerfile FROM/ARG lines, workflow ADDON_BASE_IMAGE/HA_IMAGE env vars, and ADDON_BASE_IMAGE constants in integration conftests. A single manager across all three file types so a base-image bump moves every reference together in one PR (the alternative — separate per-file managers or relying on the built-in dockerfile manager for FROM + inline ``# renovate:`` annotations for the rest — split the bumps across two PRs and stranded one set when the other was merged).",
      "managerFilePatterns": [
        "/Dockerfile$/",
        "/\\.github/workflows/.+\\.ya?ml$/",
        "/tests/integration/conftest\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/home-assistant/[\\w.-]+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub runner versions in shell scripts and YAML within workflows",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "runner=\"(?<depName>ubuntu|macos|windows)-(?<currentValue>[\\w.-]+)\"",
        "runs-on:\\s*(?<depName>ubuntu|macos|windows)-(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "Renovate npm package version pinned in CI workflows",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["npx --package renovate@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Pinned ffmpeg apt package in the integration-test workflow",
      "managerFilePatterns": ["/.github/workflows/tests\\.ya?ml$/"],
      "matchStrings": ["FFMPEG_APT_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ffmpeg",
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "APK packages pinned in Alpine 3.24 Dockerfiles",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "\\s+(?<depName>[a-z][a-z0-9_+.-]*)=(?<currentValue>[\\d][\\w.-]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine_3_24/{{depName}}"
    },
    {
      "customType": "regex",
      "description": "home-assistant/builder build-image action (calver-tagged sub-path)",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "home-assistant/builder/actions/build-image@(?<currentValue>[\\w.-]+)"
      ],
      "depNameTemplate": "home-assistant/builder",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "frenck/action-addon-linter schema URLs in pre-commit config",
      "managerFilePatterns": ["/\\.pre-commit-config\\.ya?ml$/"],
      "matchStrings": ["frenck/action-addon-linter/(?<currentValue>v[\\d.]+)/"],
      "depNameTemplate": "frenck/action-addon-linter",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "npm-style entries inside pre-commit additional_dependencies",
      "managerFilePatterns": ["/\\.pre-commit-config\\.ya?ml$/"],
      "matchStrings": ["\"(?<depName>@[\\w./-]+)@(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "uv tool required-version pin in pyproject.toml [tool.uv]",
      "managerFilePatterns": ["/(^|/)pyproject\\.toml$/"],
      "matchStrings": ["required-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["uv"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["devcontainer"],
      "groupName": "dev container"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/home-assistant/"],
      "groupName": "home-assistant base images"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["repology"],
      "groupName": "alpine apk packages"
    },
    {
      "description": "ffmpeg apt package resolves from the Ubuntu 24.04 (noble) universe archive, matching the GitHub runner's sources",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "http://archive.ubuntu.com/ubuntu?suite=noble&components=universe&binaryArch=amd64",
        "http://archive.ubuntu.com/ubuntu?suite=noble-updates&components=universe&binaryArch=amd64",
        "http://security.ubuntu.com/ubuntu?suite=noble-security&components=universe&binaryArch=amd64"
      ],
      "groupName": "apt packages"
    },
    {
      "description": "igt-gpu-tools comes from Alpine edge/testing, not the stable Alpine 3.24 repo",
      "matchPackageNames": ["alpine_3_24/igt-gpu-tools"],
      "matchDatasources": ["repology"],
      "overridePackageName": "alpine_edge/igt-gpu-tools"
    },
    {
      "description": "onevpl-intel-gpu comes from Alpine edge/testing, not the stable Alpine 3.24 repo",
      "matchPackageNames": ["alpine_3_24/onevpl-intel-gpu"],
      "matchDatasources": ["repology"],
      "overridePackageName": "alpine_edge/onevpl-intel-gpu"
    },
    {
      "description": "Avoid duplicate PRs: the custom regex manager above already handles ghcr.io/home-assistant/* FROM lines in Dockerfiles; disabling the built-in dockerfile manager for those packages keeps the regex manager as the single source so we don't get two PRs (one per datasource) on every base-image bump. The /.../ matchPackageNames is regex syntax matching any package name containing 'home-assistant' — the dockerfile manager only sees image names, so this can only hit the HA base images.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["/home-assistant/"],
      "enabled": false
    },
    {
      "description": "Hold CI Python on the 3.14 line to match the Alpine 3.24 base image runtime (python3=3.14.5-r0)",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
