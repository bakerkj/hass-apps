{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["on sunday"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Home Assistant add-on base images in Dockerfiles",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "[\\s=](?<depName>ghcr\\.io/home-assistant/[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub runner versions assigned in shell scripts within workflows",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "runner=\"(?<depName>(?:ubuntu|macos|windows)-(?<currentValue>[\\w.-]+))\"",
        "runs-on:\\s*(?<depName>(?:ubuntu|macos|windows)-(?<currentValue>[\\w.-]+))"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "APK packages pinned in Alpine 3.23 Dockerfiles",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "\\s+(?<depName>[a-z][a-z0-9_+.-]*)=(?<currentValue>[\\d][\\w.-]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine_3_23/{{depName}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["uv"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["devcontainer"],
      "groupName": "dev container"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/home-assistant/"],
      "groupName": "home-assistant base images"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["repology"],
      "groupName": "alpine apk packages"
    },
    {
      "description": "igt-gpu-tools comes from Alpine edge/testing, not the stable Alpine 3.23 repo",
      "matchPackageNames": ["alpine_3_23/igt-gpu-tools"],
      "matchDatasources": ["repology"],
      "overridePackageName": "alpine_edge/igt-gpu-tools"
    },
    {
      "description": "onevpl-intel-gpu comes from Alpine edge/testing, not the stable Alpine 3.23 repo",
      "matchPackageNames": ["alpine_3_23/onevpl-intel-gpu"],
      "matchDatasources": ["repology"],
      "overridePackageName": "alpine_edge/onevpl-intel-gpu"
    }
  ]
}
