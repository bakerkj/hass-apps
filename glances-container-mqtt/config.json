{
  "name": "Glances Container Stats MQTT",
  "slug": "glances_container_mqtt",
  "description": "Polls Glances container stats and publishes Home Assistant MQTT Discovery sensors with one device per container.",
  "url": "https://github.com/bakerkj/hass-apps/",
  "version": "0.0.4",
  "arch": ["amd64", "aarch64", "armv7", "i386"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "hassio_api": true,
  "homeassistant_api": true,
  "host_network": false,
  "ingress": false,
  "full_access": false,
  "options": {
    "interval_seconds": 10,
    "glances_url": "http://localhost:61209",
    "glances_endpoint": "/api/3/containers",
    "glances_username": "",
    "glances_password": "",
    "glances_timeout_seconds": 10,
    "include_metrics": "cpu_percent,memory_usage,network_rx_total,network_tx_total,io_read_total,io_write_total",
    "container_include_regex": "",
    "container_exclude_regex": "",
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "glances_containers",
    "client_id": "glances-container-mqtt",
    "log_level": "INFO",
    "heartbeat_interval_seconds": 30
  },
  "schema": {
    "interval_seconds": "int(1,300)",
    "glances_url": "str",
    "glances_endpoint": "str",
    "glances_username": "str?",
    "glances_password": "password?",
    "glances_timeout_seconds": "int(1,120)",
    "include_metrics": "str",
    "container_include_regex": "str?",
    "container_exclude_regex": "str?",
    "mqtt_host": "str",
    "mqtt_port": "port",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str",
    "mqtt_base_topic": "str",
    "client_id": "str",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "heartbeat_interval_seconds": "int(5,600)"
  }
}
