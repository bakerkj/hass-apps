{
  "name": "Frigate Compressor",
  "version": "0.0.32",
  "slug": "frigate_compressor",
  "description": "Compresses old Frigate NVR recordings using Intel QSV (or NVENC/CPU fallback). Two-tier compression based on age. Tracks state in a local SQLite database.",
  "url": "https://github.com/bakerkj/hass-apps",
  "arch": ["amd64"],
  "init": false,
  "video": true,
  "map": ["media:rw", "addon_config:rw", "all_addon_configs:rw"],
  "devices": ["/dev/dri"],
  "options": {
    "encoder": "qsv",
    "max_parallel_jobs": 2,
    "housekeeping_interval_days": 7,
    "frigate_db": "/addon_configs/ccab4aaf_frigate-fa/frigate.db",
    "recordings_dir": "/media/frigate/recordings",
    "compress_db": "/config/compress.db",
    "config_path": "/config/config.yaml",
    "log_level": "INFO",
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_discovery_prefix": "homeassistant",
    "mqtt_base_topic": "frigate_compressor",
    "mqtt_client_id": "frigate-compressor",
    "mqtt_publish_interval_seconds": 60,
    "mqtt_disconnect_timeout_seconds": 300,
    "mqtt_backlog_timeout_seconds": 3600,
    "rate_window_seconds": 300
  },
  "schema": {
    "encoder": "list(qsv|vaapi|nvenc|cpu)",
    "max_parallel_jobs": "int(1,8)",
    "housekeeping_interval_days": "int(1,365)",
    "frigate_db": "str",
    "recordings_dir": "str",
    "compress_db": "str",
    "config_path": "str",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR)",
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_discovery_prefix": "str?",
    "mqtt_base_topic": "str?",
    "mqtt_client_id": "str?",
    "mqtt_publish_interval_seconds": "int(5,3600)?",
    "mqtt_disconnect_timeout_seconds": "int(5,3600)?",
    "mqtt_backlog_timeout_seconds": "int(60,86400)?",
    "rate_window_seconds": "int(60,86400)?"
  },
  "panel_icon": "mdi:video-check"
}
